# Tài khoản dùng để đăng nhập vai trò "Học thuật" (được quyền sửa).
# Đặt 2 biến này trong Vercel (Project Settings -> Environment Variables).
# Không có ADMIN_PASSWORD thì toàn bộ ứng dụng chỉ ở chế độ xem (an toàn mặc định).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay-truoc-khi-deploy

# POSTGRES_URL và các biến POSTGRES_* khác được Vercel TỰ ĐỘNG thêm vào
# khi bạn gắn một Postgres database (tab Storage) vào project trên Vercel.
# Bạn KHÔNG cần tự nhập các biến này.
